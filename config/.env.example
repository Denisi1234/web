#!/usr/bin/env bash
# ==============================================================================
# fastnetstays.com - Environment Configuration Template
# ==============================================================================
# To use this file:
# 1. Copy this file to `config/.env` (or root `.env`).
# 2. Set the values through your hosting provider in production.
# ==============================================================================

# Application Branding & Identity
export APP_NAME="FastNetStays"
export APP_ENCODING="UTF-8"
export APP_DEFAULT_LOCALE="en_US"
export APP_DEFAULT_TIMEZONE="Africa/Dar_es_Salaam"

# Security Encryption Key (Keep secret in production!)
export SECURITY_SALT="replace-with-a-long-random-secret"

# ------------------------------------------------------------------------------
# PRODUCTION ENVIRONMENT CONFIGURATION (DEFAULT)
# ------------------------------------------------------------------------------
export APP_ENV="production"
export DEBUG="false"
export APP_FULL_BASE_URL="https://fastnetstays.com"
export BACKEND_API_URL="https://api.fastnetstays.com/api"

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
export DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Cache Configuration
# export CACHE_DURATION="+2 minutes"

# ------------------------------------------------------------------------------
# MAPS (host-portal picker + search autocomplete)
# ------------------------------------------------------------------------------
# Optional: without a pk.* token the app uses free OpenStreetMap tiles +
# Nominatim search, so maps still work. Set it for the premium Mapbox style.
# export MAPBOX_TOKEN="pk.your_real_mapbox_token_here"
# export MAPBOX_STYLE="mapbox://styles/mapbox/streets-v12"

# ------------------------------------------------------------------------------
# CONTABO / VPS DEPLOY CHECKLIST (must match local working config)
# ------------------------------------------------------------------------------
# 1. `composer install --no-dev --optimize-autoloader` (creates
#    config/app_local.php with a random salt + tmp/ + logs/ automatically)
# 2. Or verify with: `bin/cake deploy:check`
# 3. Point the vhost DocumentRoot at `webroot/` with AllowOverride All
#    (Apache) or the nginx rules in docker/nginx.conf
# 4. `chown -R www-data:www-data tmp logs && chmod -R 775 tmp logs`
