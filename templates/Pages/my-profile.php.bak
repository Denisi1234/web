<?php $this->start('script'); ?>
<script>
// ── Auth Guard (runs before DOMContentLoaded) ────────────────────────────────
(function() {
    const token = localStorage.getItem('auth_token') || localStorage.getItem('token');
    if (!token) {
        window.location.href = '<?= $this->Url->build('/login'); ?>?redirect=<?= urlencode($this->Url->build('/my-profile')); ?>';
    }
})();

// ── Helpers ──────────────────────────────────────────────────────────────────
function apiUrl(path) {
    return (typeof window.API_URL === 'function') ? window.API_URL(path) : 'http://127.0.0.1:8000' + path;
}

function authHeaders() {
    const token = localStorage.getItem('auth_token') || localStorage.getItem('token');
    return {
        'Authorization': 'Bearer ' + (token || ''),
        'Content-Type': 'application/json',
        'Accept': 'application/json'
    };
}

function showAlert(id, msg, success = false) {
    const el = document.getElementById(id);
    if (!el) return;
    el.style.display = 'block';
    el.innerHTML = `<div class="alert alert-${success ? 'success' : 'danger'} py-2 mb-0">${msg}</div>`;
    setTimeout(() => { el.style.display = 'none'; }, 6000);
}

function setBtnLoading(btnId, textId, spinnerId, loading, label) {
    const btn = document.getElementById(btnId);
    const txt = document.getElementById(textId);
    const spin = document.getElementById(spinnerId);
    if (!btn) return;
    btn.disabled = loading;
    if (txt)  txt.textContent = loading ? 'Saving...' : label;
    if (spin) spin.classList.toggle('d-none', !loading);
}

// ── Populate page with user data ─────────────────────────────────────────────
function populatePage(user) {
    const fullName = user.name
        || ((user.first_name || '') + ' ' + (user.last_name || '')).trim()
        || (user.email ? user.email.split('@')[0] : 'Traveler');
    const initial = (fullName[0] || '?').toUpperCase();

    // Sidebar
    const setTxt = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
    setTxt('sidebar-user-name',     fullName);
    setTxt('sidebar-user-email',    user.email || '');
    setTxt('sidebar-email-display', user.email || '—');
    setTxt('sidebar-phone-display', user.phone || user.phone_number || '—');

    const avatarCircle = document.getElementById('profile-avatar-circle');
    if (avatarCircle) avatarCircle.textContent = initial;

    const badge = document.getElementById('sidebar-email-badge');
    if (badge) {
        const verified = user.email_verified_at || user.email_verified;
        badge.className = verified ? 'badge bg-success' : 'badge bg-warning text-dark';
        badge.textContent = verified ? 'Verified' : 'Not Verified';
    }

    // Form fields
    const nameParts = fullName.split(' ');
    const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.value = val || ''; };
    setVal('profile-first-name', user.first_name || nameParts[0] || '');
    setVal('profile-last-name',  user.last_name  || nameParts.slice(1).join(' ') || '');
    setVal('profile-email',      user.email || '');
    setVal('profile-phone',      user.phone || user.phone_number || '');
    setVal('profile-dob',        user.date_of_birth || user.dob || '');
    setVal('profile-about',      user.bio || user.about || '');

    const genderSel = document.getElementById('profile-gender');
    if (genderSel && user.gender) genderSel.value = user.gender.toLowerCase();

    if (user.avatar) {
        const preview = document.getElementById('uploadfile-1-preview');
        if (preview) preview.src = user.avatar;
    }
}

// ── Load user from API ───────────────────────────────────────────────────────
async function loadUserData() {
    // Instant render from localStorage (no flicker)
    const stored = localStorage.getItem('user');
    if (stored) {
        try { populatePage(JSON.parse(stored)); } catch(e) {}
    }

    // Then fetch fresh from API
    try {
        const res = await fetch(apiUrl('/api/user'), { headers: authHeaders() });

        if (res.status === 401) {
            localStorage.removeItem('auth_token');
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            window.location.href = '<?= $this->Url->build('/login'); ?>';
            return;
        }
        if (res.ok) {
            const data = await res.json();
            const u = data.user || data.data || data;
            if (u && (u.id || u.email)) {
                localStorage.setItem('user', JSON.stringify(u));
                populatePage(u);
            }
        }
    } catch(e) { /* Backend unreachable — localStorage data is shown */ }
}

// ── Photo preview ────────────────────────────────────────────────────────────
document.getElementById('uploadfile-1')?.addEventListener('change', function() {
    const file = this.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
        const preview = document.getElementById('uploadfile-1-preview');
        if (preview) preview.src = e.target.result;
    };
    reader.readAsDataURL(file);
});

// ── Personal Info Form ───────────────────────────────────────────────────────
document.getElementById('profile-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    setBtnLoading('profile-save-btn', 'profile-save-text', 'profile-save-spinner', true, 'Save Changes');

    const firstName = document.getElementById('profile-first-name').value.trim();
    const lastName  = document.getElementById('profile-last-name').value.trim();
    const payload = {
        first_name:    firstName,
        last_name:     lastName,
        name:          (firstName + ' ' + lastName).trim(),
        phone:         document.getElementById('profile-phone').value.trim(),
        date_of_birth: document.getElementById('profile-dob').value,
        gender:        document.getElementById('profile-gender').value,
        bio:           document.getElementById('profile-about').value.trim(),
    };

    try {
        const res = await fetch(apiUrl('/api/user/update'), {
            method: 'POST',
            headers: authHeaders(),
            body: JSON.stringify(payload)
        });
        const data = await res.json();

        if (res.ok) {
            try {
                const stored = localStorage.getItem('user');
                const u = stored ? { ...JSON.parse(stored), ...payload } : payload;
                localStorage.setItem('user', JSON.stringify(u));
                populatePage(u);
            } catch(er) {}
            showAlert('profile-alert', data.message || 'Profile updated successfully!', true);
        } else {
            const msg = data.message || (data.errors ? Object.values(data.errors).flat().join('<br>') : 'Update failed. Please try again.');
            showAlert('profile-alert', msg);
        }
    } catch(err) {
        showAlert('profile-alert', 'Unable to reach the server. Please check your connection.');
    } finally {
        setBtnLoading('profile-save-btn', 'profile-save-text', 'profile-save-spinner', false, 'Save Changes');
    }
});

// ── Update Email Form ────────────────────────────────────────────────────────
document.getElementById('email-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const newEmail = document.getElementById('new-email').value.trim();
    if (!newEmail) { showAlert('email-alert', 'Please enter a new email address.'); return; }

    setBtnLoading('email-save-btn', 'email-save-text', 'email-save-spinner', true, 'Update Email');

    try {
        const res = await fetch(apiUrl('/api/user/update-email'), {
            method: 'POST',
            headers: authHeaders(),
            body: JSON.stringify({ email: newEmail })
        });
        const data = await res.json();

        if (res.ok) {
            try {
                const stored = localStorage.getItem('user');
                if (stored) {
                    const u = { ...JSON.parse(stored), email: newEmail };
                    localStorage.setItem('user', JSON.stringify(u));
                    populatePage(u);
                }
            } catch(er) {}
            document.getElementById('new-email').value = '';
            showAlert('email-alert', data.message || 'Email updated! Please check your inbox to verify.', true);
        } else {
            const msg = data.message || (data.errors ? Object.values(data.errors).flat().join('<br>') : 'Email update failed.');
            showAlert('email-alert', msg);
        }
    } catch(err) {
        showAlert('email-alert', 'Unable to reach the server. Please check your connection.');
    } finally {
        setBtnLoading('email-save-btn', 'email-save-text', 'email-save-spinner', false, 'Update Email');
    }
});

// ── Change Password Form ─────────────────────────────────────────────────────
document.getElementById('password-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();

    const currentPw = document.getElementById('current-password').value;
    const newPw     = document.getElementById('new-password').value;
    const confirmPw = document.getElementById('confirm-password').value;

    if (newPw !== confirmPw) { showAlert('password-alert', 'New password and confirmation do not match.'); return; }
    if (newPw.length < 8)   { showAlert('password-alert', 'Password must be at least 8 characters.'); return; }

    setBtnLoading('password-save-btn', 'password-save-text', 'password-save-spinner', true, 'Change Password');

    try {
        const res = await fetch(apiUrl('/api/user/change-password'), {
            method: 'POST',
            headers: authHeaders(),
            body: JSON.stringify({
                current_password:          currentPw,
                new_password:              newPw,
                new_password_confirmation: confirmPw
            })
        });
        const data = await res.json();

        if (res.ok) {
            document.getElementById('current-password').value = '';
            document.getElementById('new-password').value     = '';
            document.getElementById('confirm-password').value = '';
            showAlert('password-alert', data.message || 'Password changed successfully!', true);
        } else {
            const msg = data.message || (data.errors ? Object.values(data.errors).flat().join('<br>') : 'Password change failed.');
            showAlert('password-alert', msg);
        }
    } catch(err) {
        showAlert('password-alert', 'Unable to reach the server. Please check your connection.');
    } finally {
        setBtnLoading('password-save-btn', 'password-save-text', 'password-save-spinner', false, 'Change Password');
    }
});

// ── Init ──────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', loadUserData);

function moveToNext(currentInput) {
    if (currentInput.value.length === 1) {
        const next = currentInput.nextElementSibling;
        if (next) next.focus();
    }
}
</script>
<?php $this->end(); ?>