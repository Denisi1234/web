# Copy these names into the production environment settings of your host.
# Do not commit the real .env file or any value containing credentials.

APP_ENV=production
APP_NAME=FastNetStays
APP_FULL_BASE_URL=https://fastnetstays.com
DEBUG=false
APP_ENCODING=UTF-8
APP_DEFAULT_LOCALE=en_US
APP_DEFAULT_TIMEZONE=Africa/Dar_es_Salaam

# Generate a long random value and keep it secret.
SECURITY_SALT=replace-with-a-long-random-secret

# Use the PostgreSQL DATABASE_URL supplied by your managed database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
BACKEND_API_URL=https://api.fastnetstays.com/api
# Real Mapbox — backend exposes GET /api/map-config { mapbox_token, mapbox_style }
# Frontend also reads env fallback when backend is unreachable (first paint)
MAPBOX_TOKEN=pk.your_real_mapbox_token_here
MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# Optional SMTP transport, if email is enabled.
EMAIL_TRANSPORT_DEFAULT_URL=

# Keep CakePHP diagnostics disabled in production.
DEBUG_KIT_FORCE_ENABLE=false
DEBUG_KIT_IGNORE_AUTHORIZATION=false
